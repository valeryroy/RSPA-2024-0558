# diffpade.mw: This script compute the 1st-order differential Pade Approximants
# of the polarization functions from their power series in
#                lambda=(epsilon-1)/(epsilon+1)
# then plot the polarization functions at lambda=-2/z,
#                          z=x+ I*0.01, x in [-0.5,0.5]
# 1st-order differential Pade Approximants are solution of:
#
# P(lambda)*F'(lambda)+Q(lambda)*F(lambda)+R(lambda)=O(^K), K= deg(P)+deg(Q)+deg(R)+2
#
# Once P,Q, R are found from the knowledge of sum(mu[k]*lambda^k,k=0..Mmax),
# the approximant is found by integrading the ODE over a complex path
# lambda = lambda1*s from s=0 to s=1 to find the value at lambda1
#----------------------------
restart;
with(plots):with(numapprox):
Digits:=16;
read("/home/vroy/Moment-Green/dilute/2d/Lens/moments.dat"):
Mmax:= M;
y0:=0.01;
L := 3; M := 2; N := 2; # set orders of P, Q, R

if( L+M+N+1 > Mmax ) then
    print("INCREASE M!")
end if;

F1 :=mu1[0]+sum(mu1[k]*la^k,k=1..Mmax):
F2 :=mu1[0]+sum(mu2[k]*la^k,k=1..Mmax):

P1 :=  sum(p1[k]*la^k, k = 0 .. L):
p1[L] := 1;

P2 :=  sum(p2[k]*la^k, k = 0 .. L):
p2[L] := 1;


Q1 := sum(q1[k]*la^k, k = 0 .. M):
R1 := sum(r1[k]*la^k, k = 0 .. N):
g1 := series(diff(F1,la)*P1 +F1*Q1 + R1, la, L+M+N+2):

Q2 := sum(q2[k]*la^k, k = 0 .. M):
R2 := sum(r2[k]*la^k, k = 0 .. N):
g2 := series(diff(F2,la)*P2 +F2*Q2 + R2, la, L+M+N+2):


for k from 0 to L+M+N+1 do c1[k] := coeff(g1, la, k) end do:
for k from 0 to L+M+N+1 do c2[k] := coeff(g2, la, k) end do:

# find coefficients of P1,Q1, R1

solve({seq(c1[j], j = 0 .. L+M+N+1)}, {seq(p1[j], j = 0 .. L-1), seq(q1[j], j = 0 .. M), seq(r1[j], j = 0 .. N)}):

assign(%):

# find coefficients of P2,Q2, R2

solve({seq(c2[j], j = 0 .. L+M+N+1)}, {seq(p2[j], j = 0 .. L-1), seq(q2[j], j = 0 .. M), seq(r2[j], j = 0 .. N)}):

assign(%):

# solve for singularities

convert(Q1/P1,parfrac,la);
convert(Q2/P2,parfrac,la);


Npt:=500; # increase for better resolution

for i from 0 to Npt do

x[i]:= -0.5 +i/Npt:
la0:=-0.5/(x[i]+I*y0): # lambda =- 1/(2*z)

ode1 := subs(la=la0*s,P1/la0)*diff(y1(s),s) + subs(la=la0*s,Q1)*y1(s) + subs(la=la0*s,R1):
ics1 := y1(0)=1:
dsol1:=dsolve({ode1,ics1}, numeric, method = dverk78, abserr = 1.*10^(-8), relerr = 1.*10^(-8)):

sol1:=dsol1(1.0);
Polar1[i] := Im(2*la0*op(2, op(2, sol1)));

ode2 := subs(la=la0*s,P2/la0)*diff(y2(s),s) + subs(la=la0*s,Q2)*y2(s) + subs(la=la0*s,R2):
ics2 := y2(0)=1:
dsol2:=dsolve({ode2,ics2}, numeric, method = dverk78, abserr = 1.*10^(-8), relerr = 1.*10^(-8)):

sol2:=dsol2(1.0);
Polar2[i] := Im(2*la0*op(2, op(2, sol2)));

end do:

X1 := Vector(Npt, i -> x[i]):
Y1 := Vector(Npt, i -> Polar1[i]):
Y2 := Vector(Npt, i -> Polar2[i]):

dataplot(X1,[Y1,Y2],style = line);
done;
